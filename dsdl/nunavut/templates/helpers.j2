{# ============================================================================ #}
{# Helper Macros for Nunavut Go Template                                     #}
{#                                                                           #}
{# This file contains Jinja2 macros for generating Go code from DSDL.        #}
{# ============================================================================ #}

{% import 'type_map.j2' as type_map %}

{# -------------------------------------------------------------------------- #}
{# STRING UTILITIES                                                         #}
{# -------------------------------------------------------------------------- #}

{%- macro go_type_name(name) -%}
    {# Convert a DSDL type name to a valid Go type name #}
    {%- if name is none -%}
        {%- return "" -%}
    {%- endif -%}
    
    {# Replace special characters #}
    {%- set name = name | replace('.', '_') | replace('#', '_') | replace('/', '_') -%}
    
    {# Convert to PascalCase #}
    {%- set parts = name | split('_') -%}
    {%- set result = [] -%}
    {%- for part in parts -%}
        {%- if part | length > 0 -%}
            {%- do result.append(part[0] | upper + part[1:] | lower) -%}
        {%- endif -%}
    {%- endfor -%}
    
    {%- if result | length > 0 -%}
        {{ result | join('') }}
    {%- else -%}
        {{ name | title | replace(' ', '') }}
    {%- endif -%}
{%- endmacro -%}


{%- macro go_field_name(name) -%}
    {# Convert a DSDL field name to a valid Go field name #}
    {%- if name is none -%}
        {%- return "" -%}
    {%- endif -%}
    
    {# Handle special field names #}
    {%- if name | lower in ['type', 'interface', 'string', 'error', 'bool', 'int', 
                              'int8', 'int16', 'int32', 'int64', 'uint', 'uint8', 
                              'uint16', 'uint32', 'uint64', 'float32', 'float64',
                              'byte', 'rune'] -%}
        {{ name | capitalize }}
    {%- else -%}
        {# Convert snake_case to PascalCase #}
        {%- set parts = name | split('_') -%}
        {%- set result = [] -%}
        {%- for part in parts -%}
            {%- if part | length > 0 -%}
                {%- do result.append(part[0] | upper + part[1:] | lower) -%}
            {%- endif -%}
        {%- endfor -%}
        
        {%- if result | length > 0 -%}
            {{ result | join('') }}
        {%- else -%}
            {{ name | title | replace(' ', '') }}
        {%- endif -%}
    {%- endif -%}
{%- endmacro -%}


{%- macro go_package_name(namespace) -%}
    {# Convert a DSDL namespace to a Go package name #}
    {%- if namespace is none or namespace == '' -%}
        {%- return 'main' -%}
    {%- endif -%}
    
    {# Replace special characters and convert to lowercase #}
    {%- set pkg = namespace | replace('.', '_') | replace('/', '_') | replace('-', '_') | lower -%}
    
    {# Remove any remaining invalid characters #}
    {%- set pkg = pkg | regex_replace('[^a-z0-9_]', '') -%}
    
    {# Ensure it's a valid Go package name #}
    {%- if pkg | length == 0 -%}
        main
    {%- elif pkg[0] | regex_match('[0-9]') -%}
        _{{ pkg }}
    {%- else -%}
        {{ pkg }}
    {%- endif -%}
{%- endmacro -%}


{%- macro go_package_path(namespace) -%}
    {# Convert a DSDL namespace to a Go package path #}
    {%- if namespace is none or namespace == '' -%}
        {%- return '' -%}
    {%- endif -%}
    
    {# Replace dots with slashes for package path #}
    {%- set path = namespace | replace('.', '/') | lower -%}
    
    {# Remove any remaining invalid characters #}
    {%- set path = path | regex_replace('[^a-z0-9/_]', '') -%}
    
    {{ path }}
{%- endmacro -%}


{%- macro sanitize_docstring(text) -%}
    {# Sanitize DSDL documentation for Go doc comments #}
    {%- if text is none -%}
        {%- return "" -%}
    {%- endif -%}
    
    {# Remove leading/trailing whitespace #}
    {%- set text = text | trim -%}
    
    {# Replace special characters #}
    {%- set text = text | replace('/*', '') | replace('*/', '') | replace('//', '') -%}
    
    {# Escape backticks for Go doc comments #}
    {%- set text = text | replace('`', '``') -%}
    
    {{ text }}
{%- endmacro -%}


{# -------------------------------------------------------------------------- #}
{# FILE HEADER                                                              #}
{# -------------------------------------------------------------------------- #}

{%- macro header() -%}
// Code generated by Nunavut; DO NOT EDIT.
// This file was generated from DSDL definitions.
//
// Nunavut: https://github.com/OpenCyphal/nunavut
// libcanard-go: https://github.com/bezineb5/libcanard-go
//
// Generated on: {{ now() | strftime('%Y-%m-%d %H:%M:%S') }}

package main

{% endmacro -%}


{# -------------------------------------------------------------------------- #}
{# NAMESPACE/PACKAGE HANDLING                                               #}
{# -------------------------------------------------------------------------- #}

{%- macro namespace_package(namespace) -%}
{# Generate package declaration and imports for a namespace #}

// Package {{ go_package_name(namespace.name) }} contains generated types for namespace {{ namespace.name }}.
//
// This package was auto-generated from DSDL definitions using Nunavut.
// See: https://github.com/OpenCyphal/nunavut
package {{ go_package_name(namespace.name) }}

import (
	"encoding/binary"
)

{{ "\n" }}
{%- endmacro -%}


{# -------------------------------------------------------------------------- #}
{# MESSAGE TYPE GENERATION                                                  #}
{# -------------------------------------------------------------------------- #}

{%- macro message_type(message) -%}
{# Generate a Go struct for a DSDL message type #}

{# Get the full name with version #}
{%- set full_name = message.full_name -%}
{%- set short_name = message.name | go_type_name -%}
{%- set version = message.version | string -%}

{# Check if this is a sealed type #}
{%- set is_sealed = message.is_sealed -%}
{%- set is_extent_defined = message.extent > 0 -%}

{# Generate documentation #}
{%- if message.documentation -%}
// {{ short_name }} represents {{ message.full_name }}.
//
// {{ message.documentation | sanitize_docstring | indent(width=4) }}
{{ "\n" }}
{%- else -%}
// {{ short_name }} represents {{ message.full_name }}.
{{ "\n" }}
{%- endif -%}

{# Check for fixed subject ID #}
{%- if message.fixed_port_id is not none -%}
// Fixed Subject ID: {{ message.fixed_port_id }}
{{ "\n" }}
{%- endif -%}

type {{ short_name }} struct {
{% for field in message.fields %}
    {%- set field_name = field.name | go_field_name -%}
    {%- set field_type = type_map.dsdl_to_go_type_name(field.data_type.value) -%}
    {%- set offset = field.offset / 8 -%}
    
    {# Generate field documentation #}
    {%- if field.documentation -%}
    // {{ field.documentation | sanitize_docstring | indent(width=4) }}
    {%- endif -%}
    
    {# Handle special cases #}
    {%- if field_name in ['_', 'padding'] and field_type == 'uint8' -%}
    {# This is padding - use anonymous array #}
    _ [{{ field.data_type.value.capacity if field.data_type.value.category == 'ArrayType' else 1 }}]byte `dsdl:"{{ offset }}"`
    {%- else -%}
    {{ field_name }} {{ field_type }} `dsdl:"{{ offset }}"`
    {%- endif %}
{% endfor %}
}


{# Generate Size method #}
func (m {{ short_name }}) Size() int {
    return {{ message.extent / 8 if message.extent > 0 else 0 }}
}


{# Generate DSDL metadata if available #}
{%- if message.fixed_port_id is not none -%}

// FixedPortID returns the fixed port ID for this message type.
func (m {{ short_name }}) FixedPortID() uint16 {
    return {{ message.fixed_port_id }}
}
{%- endif -%}

{{ "\n" }}
{%- endmacro -%}


{# -------------------------------------------------------------------------- #}
{# SERVICE TYPE GENERATION                                                  #}
{# -------------------------------------------------------------------------- #}

{%- macro service_type(service) -%}
{# Generate Go types for a DSDL service type (request/response) #}

{%- set short_name = service.name | go_type_name -%}

{# Generate documentation #}
{%- if service.documentation -%}
// {{ short_name }}Service represents the {{ service.full_name }} service.
//
// {{ service.documentation | sanitize_docstring | indent(width=4) }}
{{ "\n" }}
{%- else -%}
// {{ short_name }}Service represents the {{ service.full_name }} service.
{{ "\n" }}
{%- endif -%}

{# Check for fixed service ID #}
{%- if service.fixed_port_id is not none -%}
// Fixed Service ID: {{ service.fixed_port_id }}
{{ "\n" }}
{%- endif -%}

{# Generate request type #}
{%- if service.request_fields | length > 0 -%}

// {{ short_name }}Request represents the request type for {{ service.full_name }}.
{%- if service.request_documentation -%}
//
// {{ service.request_documentation | sanitize_docstring | indent(width=4) }}
{%- endif %}
type {{ short_name }}Request struct {
{% for field in service.request_fields %}
    {%- set field_name = field.name | go_field_name -%}
    {%- set field_type = type_map.dsdl_to_go_type_name(field.data_type.value) -%}
    {%- set offset = field.offset / 8 -%}
    
    {# Generate field documentation #}
    {%- if field.documentation -%}
    // {{ field.documentation | sanitize_docstring | indent(width=4) }}
    {%- endif -%}
    
    {{ field_name }} {{ field_type }} `dsdl:"{{ offset }}"`
{% endfor %}
}

func (r {{ short_name }}Request) Size() int {
    return {{ service.request_extent / 8 if service.request_extent > 0 else 0 }}
}

{% else %}

// {{ short_name }}Request is an empty request type for {{ service.full_name }}.
type {{ short_name }}Request struct{}

func (r {{ short_name }}Request) Size() int {
    return 0
}

{% endif %}

{{ "\n" }}

{# Generate response type #}
{%- if service.response_fields | length > 0 -%}

// {{ short_name }}Response represents the response type for {{ service.full_name }}.
{%- if service.response_documentation -%}
//
// {{ service.response_documentation | sanitize_docstring | indent(width=4) }}
{%- endif %}
type {{ short_name }}Response struct {
{% for field in service.response_fields %}
    {%- set field_name = field.name | go_field_name -%}
    {%- set field_type = type_map.dsdl_to_go_type_name(field.data_type.value) -%}
    {%- set offset = field.offset / 8 -%}
    
    {# Generate field documentation #}
    {%- if field.documentation -%}
    // {{ field.documentation | sanitize_docstring | indent(width=4) }}
    {%- endif -%}
    
    {{ field_name }} {{ field_type }} `dsdl:"{{ offset }}"`
{% endfor %}
}

func (r {{ short_name }}Response) Size() int {
    return {{ service.response_extent / 8 if service.response_extent > 0 else 0 }}
}

{% else %}

// {{ short_name }}Response is an empty response type for {{ service.full_name }}.
type {{ short_name }}Response struct{}

func (r {{ short_name }}Response) Size() int {
    return 0
}

{% endif %}

{{ "\n" }}
{%- endmacro -%}


{# -------------------------------------------------------------------------- #}
{# TYPE ALIAS GENERATION                                                    #}
{# -------------------------------------------------------------------------- #}

{%- macro type_alias(type_def) -%}
{# Generate a Go type alias for a DSDL type definition #}

{%- set short_name = type_def.name | go_type_name -%}
{%- set underlying_type = type_map.dsdl_to_go_type_name(type_def.value) -%}

{# Generate documentation #}
{%- if type_def.documentation -%}
// {{ short_name }} represents {{ type_def.full_name }}.
//
// {{ type_def.documentation | sanitize_docstring | indent(width=4) }}
{{ "\n" }}
{%- else -%}
// {{ short_name }} represents {{ type_def.full_name }}.
{{ "\n" }}
{%- endif -%}

{# Check if it's a sealed type #}
{%- if type_def.is_sealed -%}
// @sealed
{{ "\n" }}
{%- endif -%}

{# Check for extent #}
{%- if type_def.extent > 0 -%}
// @extent {{ type_def.extent / 8 }} bytes
{{ "\n" }}
{%- endif -%}

type {{ short_name }} {{ underlying_type }}

{{ "\n" }}
{%- endmacro -%}


{# -------------------------------------------------------------------------- #}
{# CONSTANT GENERATION                                                      #}
{# -------------------------------------------------------------------------- #}

{%- macro constant_value(constant) -%}
{# Generate a Go constant for a DSDL constant #}

{%- set name = constant.name | go_type_name -%}
{%- set value = constant.value -%}
{%- set ctype = constant.type -%}

{# Determine Go type and format value #}
{%- if ctype.category == 'IntegerType' -%}
    {%- if ctype.signed -%}
        {%- set go_type = 'int' + ctype.bit_length | string -%}
    {%- else -%}
        {%- set go_type = 'uint' + ctype.bit_length | string -%}
    {%- endif -%}
    {%- set go_value = value | string -%}
{%- elif ctype.category == 'FloatType' -%}
    {%- set go_type = 'float' + ctype.bit_length | string -%}
    {%- set go_value = value | string + '.0' if value | int == value else value | string -%}
{%- elif ctype.category == 'BooleanType' -%}
    {%- set go_type = 'bool' -%}
    {%- set go_value = 'true' if value else 'false' -%}
{%- else -%}
    {%- set go_type = 'interface{}' -%}
    {%- set go_value = value | string -%}
{%- endif -%}

// {{ name }} is {{ constant.documentation | default(constant.full_name) | sanitize_docstring }}.
const {{ name }} {{ go_type }} = {{ go_value }}

{{ "\n" }}
{%- endmacro -%}


{# -------------------------------------------------------------------------- #}
{# UTILITY FUNCTIONS                                                       #}
{# -------------------------------------------------------------------------- #}

{%- macro now() -%}
    {# Return current timestamp #}
    {{ "now" | now }}
{%- endmacro -%}


{%- macro align_to(offset, alignment) -%}
    {# Calculate the next aligned offset #}
    {%- set remainder = offset % alignment -%}
    {%- if remainder == 0 -%}
        {{ offset }}
    {%- else -%}
        {{ offset + (alignment - remainder) }}
    {%- endif -%}
{%- endmacro -%}
